<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vibrar quando a moeda para (o usuário pode desligar no app). Não pede autorização. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.CaraOuCoroa">

        <!-- Abertura: é a primeira tela quando o usuário abre o app -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.CaraOuCoroa.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Boas-vindas, com a dica de adicionar o widget -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="false" />

        <!-- Tela principal do app -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Janelinha aberta pelo lápis do widget (não vai para a lista de apps recentes) -->
        <activity
            android:name=".QuickFlipActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.CaraOuCoroa.Dialog"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Caixa "Zerar tudo?" aberta pelo botão do widget (tela transparente) -->
        <activity
            android:name=".ConfirmResetActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.CaraOuCoroa.Transparent" />

        <!-- O widget da tela inicial -->
        <receiver
            android:name=".CoinWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/coin_widget_info" />
        </receiver>

    </application>

</manifest>
