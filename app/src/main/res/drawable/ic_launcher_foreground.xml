<?xml version="1.0" encoding="utf-8"?>
<!-- Primeiro plano do ícone (opção B): moeda dourada girando, com uma coroa pequena.
     Tudo fica dentro da "zona segura" para o celular poder cortar em círculo. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.86"
        android:scaleY="0.86">

        <!-- Riscos de movimento -->
        <path
            android:pathData="M22,70 C16,50 24,30 40,20"
            android:strokeAlpha="0.55"
            android:strokeColor="#FFD24F"
            android:strokeLineCap="round"
            android:strokeWidth="3" />
        <path
            android:pathData="M88,40 C94,60 86,80 70,90"
            android:strokeAlpha="0.55"
            android:strokeColor="#FFD24F"
            android:strokeLineCap="round"
            android:strokeWidth="3" />

        <!-- A moeda, inclinada -->
        <group
            android:pivotX="0"
            android:pivotY="0"
            android:rotation="-28"
            android:translateX="54"
            android:translateY="54">

            <!-- Espessura (lado escuro, deslocado) -->
            <path
                android:fillColor="#A56B00"
                android:pathData="M-15,0 a22,35 0,1 0,44 0 a22,35 0,1 0,-44 0z" />

            <!-- Face dourada com degradê -->
            <path android:pathData="M-22,0 a22,35 0,1 0,44 0 a22,35 0,1 0,-44 0z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:centerX="-7"
                        android:centerY="-14"
                        android:gradientRadius="52"
                        android:type="radial">
                        <item android:color="#FFFFF0A8" android:offset="0" />
                        <item android:color="#FFFFD24F" android:offset="0.38" />
                        <item android:color="#FFF2AE12" android:offset="0.72" />
                        <item android:color="#FFC98500" android:offset="1" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- Anel interno -->
            <path
                android:pathData="M-16,0 a16,28 0,1 0,32 0 a16,28 0,1 0,-32 0z"
                android:strokeAlpha="0.35"
                android:strokeColor="#8C5A00"
                android:strokeWidth="2.5" />

            <!-- Coroa pequena no centro -->
            <path
                android:fillColor="#F3B51C"
                android:pathData="M-9,8 L-11,-8 L-4,-2 L0,-12 L4,-2 L11,-8 L9,8 Z"
                android:strokeAlpha="0.35"
                android:strokeColor="#8C5A00"
                android:strokeWidth="1" />
        </group>

        <!-- Brilhos -->
        <path
            android:fillColor="#FFF0A8"
            android:pathData="M86,20 L88,26 L94,28 L88,30 L86,36 L84,30 L78,28 L84,26 Z" />
        <path
            android:fillAlpha="0.85"
            android:fillColor="#FFF0A8"
            android:pathData="M24,82 L25.5,86 L30,87.5 L25.5,89 L24,93 L22.5,89 L18,87.5 L22.5,86 Z" />
    </group>
</vector>
