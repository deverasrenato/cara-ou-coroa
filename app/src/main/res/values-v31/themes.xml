<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 ou mais novo: a tela de abertura do sistema também fica meia-noite, com o ícone -->
<resources>
    <style name="Theme.CaraOuCoroa.Splash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_main</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowSplashScreenBackground">@color/background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
