<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema escuro fixo (azul meia-noite e ouro), com a fonte Nunito nos textos -->
    <style name="Theme.CaraOuCoroa" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:fontFamily">@font/body_font</item>
        <item name="android:windowBackground">@drawable/bg_main</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>

    <!-- Tema da abertura: já nasce com o fundo meia-noite (sem piscar branco) -->
    <style name="Theme.CaraOuCoroa.Splash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_main</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>

    <!-- Opção de modo de jogo (botão largo, marcado = contorno dourado) -->
    <style name="ModeOption" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/mode_background</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:padding">4dp</item>
        <item name="android:textColor">@color/mode_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Número do passo (bolinha dourada) e texto do passo, nas boas-vindas -->
    <style name="StepBadge">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/step_badge</item>
        <item name="android:fontFamily">@font/title_font</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StepText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Rótulo pequeno em dourado acima de cada campo -->
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- Campo de digitar -->
    <style name="FieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/field_background</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_soft</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Tema transparente: a tela some e só a caixa "Zerar tudo?" aparece por cima da tela inicial -->
    <style name="Theme.CaraOuCoroa.Transparent" parent="Theme.AppCompat.NoActionBar">
        <item name="colorAccent">@color/accent</item>
        <item name="android:fontFamily">@font/body_font</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Tema da janelinha que abre por cima da tela inicial -->
    <style name="Theme.CaraOuCoroa.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:fontFamily">@font/body_font</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <!-- Sem a barra de título repetida (a janelinha já tem o próprio título) -->
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowTitleSize">0dp</item>
        <!-- Janelinha larga: ocupa 90% da largura da tela -->
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
