<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- A moeda, com a camada do vencedor por cima (escondida até a série terminar) -->
        <FrameLayout
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_marginTop="16dp">

            <ImageView
                android:id="@+id/coin_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/coin" />

            <LinearLayout
                android:id="@+id/winner_layer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/winner_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/winner_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="@color/accent"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/winner_suffix"
                    android:textColor="@color/text"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/replay_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/replay_button_background"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="10dp"
                    android:text="@string/replay"
                    android:textColor="#3A2A00"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

        <!-- Texto fixo abaixo da moeda, tudo centralizado (cada linha sempre no mesmo lugar) -->
        <!-- Linha 1: a pergunta -->
        <TextView
            android:id="@+id/line_1"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Placar em 3 colunas: os dois lados têm a mesma largura (peso 1),
             então o "2 x 1" do meio fica SEMPRE no centro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/score_left"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical|end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/score_center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/accent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/score_right"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Linha 3: o que saiu em cada giro -->
        <TextView
            android:id="@+id/line_3"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_soft"
            android:textSize="16sp" />

        <Button
            android:id="@+id/flip_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/flip_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/series_title"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- As opções ficam uma embaixo da outra para caber em telas estreitas -->
        <RadioGroup
            android:id="@+id/series_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/series_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/series_1"
                android:textColor="@color/text" />

            <RadioButton
                android:id="@+id/series_free"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/series_free"
                android:textColor="@color/text" />

            <RadioButton
                android:id="@+id/series_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/series_5"
                android:textColor="@color/text" />

            <RadioButton
                android:id="@+id/series_7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/series_7"
                android:textColor="@color/text" />

        </RadioGroup>

        <EditText
            android:id="@+id/question_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/question_hint"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLength="30"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/text_soft" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/labels_title"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/heads_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/heads_hint"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLength="12"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/text_soft" />

        <EditText
            android:id="@+id/tails_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/tails_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="12"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/text_soft" />

        <Button
            android:id="@+id/reset_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reset_all"
            android:textColor="@color/text_soft" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/widget_tip"
            android:textColor="@color/text_soft"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
