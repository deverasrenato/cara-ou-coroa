<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView: se a tela for pequena ou o teclado abrir, dá para rolar até o botão "Girar" -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Quantas vezes jogar: o usuário só marca uma opção (uma embaixo da outra) -->
        <RadioGroup
            android:id="@+id/series_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/series_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/series_1" />

            <RadioButton
                android:id="@+id/series_free"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/series_free" />

            <RadioButton
                android:id="@+id/series_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/series_5" />

            <RadioButton
                android:id="@+id/series_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/series_7" />

        </RadioGroup>

        <EditText
            android:id="@+id/quick_question_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/question_hint"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLength="30"
            android:maxLines="1" />

        <EditText
            android:id="@+id/quick_heads_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/heads_hint"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLength="12"
            android:maxLines="1" />

        <EditText
            android:id="@+id/quick_tails_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/tails_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="12"
            android:maxLines="1" />

        <Button
            android:id="@+id/quick_flip_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/flip_now" />

        <Button
            android:id="@+id/quick_reset_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset_all" />

    </LinearLayout>

</ScrollView>
