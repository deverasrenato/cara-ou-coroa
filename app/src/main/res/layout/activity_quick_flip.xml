<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView: se a tela for pequena ou o teclado abrir, dá para rolar até o botão "Salvar" -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/title_font"
            android:text="@string/quick_title"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Quantas vezes jogar: o usuário só marca uma opção (uma embaixo da outra) -->
        <RadioGroup
            android:id="@+id/series_group"
            android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="-4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/series_1"
                style="@style/ModeOption"
                android:text="@string/series_1" />

            <RadioButton
                android:id="@+id/series_5"
                style="@style/ModeOption"
                android:text="@string/series_5" />

            <RadioButton
                android:id="@+id/series_free"
                style="@style/ModeOption"
                android:text="@string/series_free" />

        </RadioGroup>

        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="8dp"
            android:text="@string/field_question" />

        <EditText
            android:id="@+id/quick_question_input"
            style="@style/FieldInput"
            android:hint="@string/question_hint"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLength="40" />

        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="8dp"
            android:text="@string/field_heads" />

        <EditText
            android:id="@+id/quick_heads_input"
            style="@style/FieldInput"
            android:hint="@string/heads_hint"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLength="20" />

        <TextView
            style="@style/FieldLabel"
            android:layout_marginTop="8dp"
            android:text="@string/field_tails" />

        <EditText
            android:id="@+id/quick_tails_input"
            style="@style/FieldInput"
            android:hint="@string/tails_hint"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="20" />

        <!-- Aviso: salvar começa um jogo novo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/save_notice"
            android:textColor="@color/text_soft"
            android:textSize="13sp" />

        <Button
            android:id="@+id/quick_flip_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_primary"
            android:fontFamily="@font/title_font"
            android:stateListAnimator="@null"
            android:text="@string/flip_now"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/quick_reset_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/reset_button_background"
            android:stateListAnimator="@null"
            android:text="@string/reset_all"
            android:textAllCaps="false"
            android:textColor="@color/danger"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
