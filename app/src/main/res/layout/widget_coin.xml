<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- Área da moeda e do texto: tocar na moeda gira na hora -->
    <LinearLayout
        android:id="@+id/flip_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- A moeda, com a camada do vencedor por cima (escondida até a série terminar) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/coin_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/coin"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:id="@+id/winner_layer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/winner_background"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/winner_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="#FFC83D"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/winner_suffix"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/replay_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/replay_button_background"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="@string/replay"
                    android:textColor="#3A2A00"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

        <!-- Texto fixo abaixo da moeda, tudo centralizado -->
        <!-- Linha 1: a pergunta -->
        <TextView
            android:id="@+id/line_1"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/tap_to_flip"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Placar em 3 colunas: os dois lados têm a mesma largura (peso 1),
             então o "2 x 1" do meio fica SEMPRE no centro, não importa o tamanho dos textos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/score_left"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical|end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/score_center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="#FFC83D"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/score_right"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Linha 3: o que saiu em cada giro -->
        <TextView
            android:id="@+id/line_3"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#AEB8D0"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Botão do lápis: abre a janelinha para digitar a pergunta -->
    <ImageView
        android:id="@+id/edit_button"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/edit_button_background"
        android:contentDescription="@string/edit_button"
        android:padding="7dp"
        android:src="@drawable/ic_edit" />

</FrameLayout>
